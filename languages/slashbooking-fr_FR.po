#: src/Notifications/DefaultTemplates.php:96
msgid "<p>Hi {{customer_name}},</p>\n<p>Just a reminder: your appointment <strong>{{service_name}}</strong> is scheduled for <strong>tomorrow</strong> at {{appointment_time}} ({{timezone}}).</p>\n<p>Address: {{customer_address}}</p>\n<p>Need to cancel? <a href=\"{{cancel_url}}\">Click here</a>.</p>\n<p>— {{site_name}}</p>"
msgstr "<p>Bonjour {{customer_name}},</p>\n<p>Petit rappel : votre RDV <strong>{{service_name}}</strong> est prévu <strong>demain</strong> à {{appointment_time}} ({{timezone}}).</p>\n<p>Adresse : {{customer_address}}</p>\n<p>Besoin d'annuler ? <a href=\"{{cancel_url}}\">Cliquer ici</a>.</p>\n<p>— {{site_name}}</p>"

#: src/Notifications/DefaultTemplates.php:81
msgid "<p>Hi {{customer_name}},</p>\n<p>Sorry, your appointment request for {{appointment_date}} at {{appointment_time}} could not be confirmed.</p>\n<p>Feel free to <a href=\"{{site_url}}\">pick another slot</a>.</p>\n<p>— {{site_name}}</p>"
msgstr "<p>Bonjour {{customer_name}},</p>\n<p>Désolé, votre demande de RDV pour le {{appointment_date}} à {{appointment_time}} n'a pas pu être confirmée.</p>\n<p>N'hésitez pas à <a href=\"{{site_url}}\">choisir un autre créneau</a>.</p>\n<p>— {{site_name}}</p>"

#: src/Notifications/DefaultTemplates.php:45
msgid "<p>Hi {{customer_name}},</p>\n<p>We have received your appointment request for <strong>{{service_name}}</strong> on <strong>{{appointment_date}}</strong> at <strong>{{appointment_time}}</strong>.</p>\n<p>Our team will get back to you shortly to confirm it.</p>\n<p>You can cancel at any time: <a href=\"{{cancel_url}}\">cancel this appointment</a>.</p>\n<p>— {{site_name}}</p>"
msgstr "<p>Bonjour {{customer_name}},</p>\n<p>Nous avons bien reçu votre demande de rendez-vous pour <strong>{{service_name}}</strong> le <strong>{{appointment_date}}</strong> à <strong>{{appointment_time}}</strong>.</p>\n<p>Notre équipe vous contactera très vite pour la confirmer.</p>\n<p>Vous pouvez annuler à tout moment : <a href=\"{{cancel_url}}\">annuler ce RDV</a>.</p>\n<p>— {{site_name}}</p>"

#: src/Notifications/DefaultTemplates.php:89
msgid "<p>Hi {{customer_name}},</p>\n<p>We have registered the cancellation of your appointment {{service_name}} on {{appointment_date}} at {{appointment_time}}.</p>\n<p>See you soon! <a href=\"{{site_url}}\">Book another appointment</a>.</p>"
msgstr "<p>Bonjour {{customer_name}},</p>\n<p>Nous avons bien pris en compte l'annulation de votre RDV {{service_name}} du {{appointment_date}} à {{appointment_time}}.</p>\n<p>À très vite ! <a href=\"{{site_url}}\">Reprendre un RDV</a>.</p>"

#: src/Notifications/DefaultTemplates.php:72
msgid "<p>Hi {{customer_name}},</p>\n<p>Your appointment <strong>{{service_name}}</strong> is confirmed for <strong>{{appointment_date}}</strong> from {{appointment_time}} to {{appointment_end}} ({{timezone}}).</p>\n<p>Address provided: {{customer_address}}</p>\n<p>You can add it to your calendar via the attached .ics file, or <a href=\"{{cancel_url}}\">cancel this appointment</a>.</p>\n<p>See you soon!<br>{{site_name}}</p>"
msgstr "<p>Bonjour {{customer_name}},</p>\n<p>Votre RDV <strong>{{service_name}}</strong> est confirmé pour le <strong>{{appointment_date}}</strong> de {{appointment_time}} à {{appointment_end}} ({{timezone}}).</p>\n<p>Adresse renseignée : {{customer_address}}</p>\n<p>Vous pouvez l'ajouter à votre agenda via la pièce jointe .ics, ou <a href=\"{{cancel_url}}\">annuler ce RDV</a>.</p>\n<p>À très vite !<br>{{site_name}}</p>"

#: src/Notifications/DefaultTemplates.php:54
msgid "<p>New appointment request to review:</p>\n<ul>\n  <li><strong>Service:</strong> {{service_name}} ({{service_duration}})</li>\n  <li><strong>When:</strong> {{appointment_date}} from {{appointment_time}} to {{appointment_end}}</li>\n  <li><strong>Customer:</strong> {{customer_name}} — {{customer_email}} — {{customer_phone}}</li>\n  <li><strong>Address:</strong> {{customer_address}}</li>\n  <li><strong>Notes:</strong> {{notes}}</li>\n</ul>\n<p>\n  <a href=\"{{confirm_url}}\" style=\"background:#16a34a;color:#fff;padding:10px 16px;text-decoration:none;border-radius:4px;\">Confirm</a>\n  &nbsp;\n  <a href=\"{{reject_url}}\" style=\"background:#dc2626;color:#fff;padding:10px 16px;text-decoration:none;border-radius:4px;\">Decline</a>\n</p>\n<p style=\"font-size:12px;color:#666\">The links expire in 72 h.</p>"
msgstr "<p>Nouvelle demande de RDV à valider :</p>\n<ul>\n  <li><strong>Service :</strong> {{service_name}} ({{service_duration}})</li>\n  <li><strong>Quand :</strong> {{appointment_date}} de {{appointment_time}} à {{appointment_end}}</li>\n  <li><strong>Client :</strong> {{customer_name}} — {{customer_email}} — {{customer_phone}}</li>\n  <li><strong>Adresse :</strong> {{customer_address}}</li>\n  <li><strong>Notes :</strong> {{notes}}</li>\n</ul>\n<p>\n  <a href=\"{{confirm_url}}\" style=\"background:#16a34a;color:#fff;padding:10px 16px;text-decoration:none;border-radius:4px;\">Confirmer</a>\n  &nbsp;\n  <a href=\"{{reject_url}}\" style=\"background:#dc2626;color:#fff;padding:10px 16px;text-decoration:none;border-radius:4px;\">Refuser</a>\n</p>\n<p style=\"font-size:12px;color:#666\">Les liens expirent dans 72 h.</p>"


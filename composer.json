{
  "name": "slash/booking",
  "description": "WordPress online booking plugin with a real-time public calendar and one-click email confirmation",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.0",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Slash\\Booking\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Slash\\Booking\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite unit --bootstrap tests/bootstrap.php",
    "test:integration": "phpunit --testsuite integration --bootstrap tests/Integration/bootstrap-wp.php",
    "stan": "phpstan analyse --memory-limit=1G",
    "cs": "phpcs",
    "cs:fix": "phpcbf"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
